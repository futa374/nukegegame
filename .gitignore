# ==============================
# Unity .gitignore
# ==============================

# Auto-generated / cache folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Visual Studio / Rider / VS Code
.vs/
.vsconfig
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated
ExportedObj/
.consulo/
*.tmp
*.stackdump

# Crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Gradle cache
.gradle/

# macOS
.DS_Store

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/

# Unity3D Generated File On Crash Reports
crashlytics-build.properties

# 作業中の確認用スクリーンショット（成果物ではない）
/Assets/Screenshots/
